#!/usr/bin/env bash
# Hook versionné : activé via `scripts/setup-git-hooks.sh` (git config core.hooksPath .githooks).
# Bloque le commit si Semgrep trouve un problème dans les fichiers stagés.
# Échappatoire volontaire : SKIP_SEMGREP=1 git commit ...
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ "${SKIP_SEMGREP:-0}" = "1" ]; then
  echo "SKIP_SEMGREP=1 : scan Semgrep ignoré pour ce commit."
  exit 0
fi

STAGED_FILES=()
while IFS= read -r f; do
  [ -n "$f" ] && STAGED_FILES+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR)

if [ "${#STAGED_FILES[@]}" -eq 0 ]; then
  exit 0
fi

echo "Semgrep (Docker) : analyse de ${#STAGED_FILES[@]} fichier(s) stagé(s)..."

# Dans un worktree, git exporte GIT_DIR (sans GIT_WORK_TREE) aux hooks : un
# `git rev-parse --show-toplevel` lancé depuis scripts/ renvoie alors scripts/,
# que semgrep-scan.sh montait dans Docker (« Invalid scanning root »). Le scan
# n'a pas besoin de l'environnement git du commit : on le lui retire. Comme
# core.hooksPath est absolu (ce fichier, dans le checkout principal), cela
# couvre aussi les worktrees dont la branche a une ancienne version du script.
if ! (unset GIT_DIR GIT_WORK_TREE; "$REPO_ROOT/scripts/semgrep-scan.sh" "${STAGED_FILES[@]}"); then
  echo ""
  echo "Semgrep a trouvé des problèmes bloquants. Corrige-les avant de commit."
  echo "Pour forcer le commit malgré tout : SKIP_SEMGREP=1 git commit ..."
  exit 1
fi
